
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Meal {
  id        Int      @id @default(autoincrement())
  userId String
  mainTitle      String
  secondaryTitle String
  imagePath String
  tags String[]
  ingredients String[]
  notes String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
